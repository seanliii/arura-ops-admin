# Copy to .env only when overriding local defaults. Do not commit real credentials.
DRAMA_MODE=local
DRAMA_PAYMENT_MODE=disabled
DRAMA_HOST=127.0.0.1
DRAMA_PORT=5310

# Optional data directory; local default is .local, which is ignored by Git.
# DRAMA_DATA_DIR=/absolute/path/to/private-data

# First local start generates random credentials in .local/admin-credentials.txt.
# Set both variables only if you need to initialize a fresh database explicitly.
# A configured administrator password must be at least 10 characters.
# DRAMA_ADMIN_EMAIL=
# DRAMA_ADMIN_PASSWORD=
