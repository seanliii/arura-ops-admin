{
  "name": "tt-minis-dramaverse",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "arura运营后台",
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "setup:local": "node --env-file-if-exists=.env --import tsx scripts/setup-local.ts",
    "build:admin": "vue-tsc --noEmit -p admin/tsconfig.json && vite build --config vite.admin.config.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs",
    "build": "npm run build:admin && npm run build:server",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "local": "npm run build && npm start"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "overrides": {
    "express": "4.22.3",
    "qs": "6.16.0",
    "handlebars": "4.7.10",
    "ttmg-pack": {
      "glob": "11.1.0"
    }
  },
  "dependencies": {
    "@byteplus/sdk-core": "1.0.2",
    "@byteplus/sts": "1.0.3",
    "@byteplus/uploader": "1.1.3",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pinia": "^2.1.7",
    "vant": "^4.9.0",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "4.17.25",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-vue": "5.2.4",
    "supertest": "7.3.1",
    "tiktok-minis-cli": "0.0.7",
    "tsx": "4.23.15",
    "typescript": "^5.4.5",
    "unplugin-vue-components": "32.1.0",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "vue-tsc": "^2.0.19"
  }
}
